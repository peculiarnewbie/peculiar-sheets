{
	"name": "peculiar-sheets-hyperformula",
	"version": "0.11.0",
	"private": true,
	"description": "Optional GPL HyperFormula adapter for peculiar-sheets. Not part of the formula-free core distribution.",
	"license": "GPL-3.0-only",
	"author": "peculiarnewbie",
	"repository": {
		"type": "git",
		"url": "https://github.com/peculiarnewbie/spreadsheets"
	},
	"homepage": "https://sheets.peculiarnewbie.com",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"prepublishOnly": "tsdown"
	},
	"keywords": [
		"spreadsheet",
		"solidjs",
		"hyperformula",
		"gpl",
		"formula",
		"peculiar-sheets"
	],
	"peerDependencies": {
		"peculiar-sheets": "workspace:*",
		"solid-js": "^1.9.0"
	},
	"dependencies": {
		"hyperformula": "^3.0.0"
	},
	"devDependencies": {
		"peculiar-sheets": "workspace:*",
		"tsdown": "^0.12.0",
		"typescript": "^5.8.0"
	}
}
