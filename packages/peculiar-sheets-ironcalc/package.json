{
	"name": "peculiar-sheets-ironcalc",
	"version": "0.11.1",
	"description": "Official IronCalc formula-engine adapter for Peculiar Sheets.",
	"license": "MIT",
	"author": "peculiarnewbie",
	"repository": {
		"type": "git",
		"url": "https://github.com/peculiarnewbie/spreadsheets"
	},
	"homepage": "https://sheets.peculiarnewbie.com",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"pack:check": "tsdown && bun ./scripts/pack-check.ts",
		"prepublishOnly": "pnpm run pack:check",
		"publish:npm": "npm publish --access public"
	},
	"keywords": [
		"spreadsheet",
		"solidjs",
		"ironcalc",
		"wasm",
		"formula",
		"peculiar-sheets"
	],
	"peerDependencies": {
		"peculiar-sheets": "0.11.x"
	},
	"dependencies": {
		"@ironcalc/wasm": "^0.7.0"
	},
	"devDependencies": {
		"peculiar-sheets": "0.11.0",
		"tsdown": "^0.12.0",
		"typescript": "^5.8.0"
	}
}
