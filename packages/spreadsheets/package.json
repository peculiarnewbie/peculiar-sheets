{
	"name": "peculiar-sheets",
	"version": "0.13.0",
	"description": "A high-performance SolidJS spreadsheet grid. Formula evaluation is optional and not bundled.",
	"license": "MIT",
	"author": "peculiarnewbie",
	"repository": {
		"type": "git",
		"url": "https://github.com/peculiarnewbie/spreadsheets"
	},
	"homepage": "https://sheets.peculiarnewbie.com",
	"type": "module",
	"publishConfig": {
		"access": "public",
		"tag": "latest"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./styles": "./dist/sheet.css"
	},
	"files": [
		"dist",
		"LICENSE",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "tsdown",
		"dev": "tsdown --watch",
		"typecheck": "tsc --noEmit -p tsconfig.src.json",
		"typecheck:all": "tsc --noEmit",
		"pack:check": "bun ./scripts/pack-check.ts",
		"prepublishOnly": "tsdown && bun ./scripts/pack-check.ts",
		"publish:npm": "tsdown && bun ./scripts/pack-check.ts && npm publish --access public"
	},
	"keywords": [
		"spreadsheet",
		"solidjs",
		"sheet",
		"grid",
		"datagrid",
		"excel",
		"cells"
	],
	"peerDependencies": {
		"solid-js": "2.0.0-rc.7",
		"@solidjs/web": "2.0.0-rc.7"
	},
	"dependencies": {
		"@tanstack/virtual-core": "3.17.9",
		"better-result": "^2.8.2"
	},
	"devDependencies": {
		"@solidjs/compiler": "2.0.0-rc.7",
		"@solidjs/web": "2.0.0-rc.7",
		"solid-js": "2.0.0-rc.7",
		"hyperformula": "^3.3.0",
		"tsdown": "0.23.0",
		"typescript": "^5.8.0"
	}
}
