{
	"private": true,
	"type": "module",
	"scripts": {
		"test": "bun test --conditions=browser packages/spreadsheets/src packages/peculiar-sheets-ironcalc/src",
		"test:solid2": "vitest run",
		"typecheck:solid2": "tsc --noEmit -p tests/solid2/tsconfig.json",
		"test:consumer": "bun tests/solid2/prepare-consumer.ts",
		"format:check": "bun scripts/check-changed.ts format",
		"lint": "bun scripts/check-changed.ts lint",
		"build": "pnpm -r build",
		"dev": "pnpm -r --parallel dev",
		"build:lib": "pnpm --filter peculiar-sheets build",
		"pretypecheck": "pnpm --filter peculiar-sheets build",
		"typecheck": "pnpm -r typecheck",
		"typecheck:lib": "pnpm --filter peculiar-sheets typecheck",
		"build:www": "pnpm --filter solid-sheet-www build",
		"pack:check": "pnpm --filter peculiar-sheets pack:check && pnpm --filter peculiar-sheets-ironcalc pack:check",
		"publish": "pnpm run publish:core",
		"publish:core": "pnpm --filter peculiar-sheets run publish:npm",
		"e2e": "bun run tests/e2e/run.ts",
		"e2e:production": "bun run tests/e2e/run.ts --production",
		"e2e:formula-production": "bun run tests/e2e/run.ts --production --test=tests/e2e/formula-clean-mount.test.ts",
		"e2e:formula-lazy-production": "bun run tests/e2e/run.ts --production --test=tests/e2e/formula-lazy-mount.test.ts",
		"e2e:dev": "pnpm --filter @peculiarnewbie/e2e dev",
		"benchmark": "tsx benchmarks/launch.ts",
		"benchmark:report": "tsx benchmarks/report.ts",
		"benchmark:test": "tsx --test benchmarks/*.test.ts",
		"benchmark:typecheck": "tsc --noEmit -p benchmarks/tsconfig.json && pnpm --filter @peculiarnewbie/benchmarks typecheck"
	},
	"packageManager": "pnpm@10.33.0",
	"pnpm": {
		"overrides": {
			"hyperformula": "3.5.0",
			"solid-js": "2.0.0-rc.20",
			"@solidjs/web": "2.0.0-rc.20",
			"@solidjs/signals": "2.0.0-rc.20",
			"@solidjs/compiler": "2.0.0-rc.20",
			"@solidjs/babel-plugin": "2.0.0-rc.20"
		}
	},
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"devDependencies": {
		"@biomejs/biome": "2.6.4",
		"@browserbasehq/stagehand": "^3.7.3",
		"@solidjs/testing-library": "1.0.0-rc.2",
		"@solidjs/vite-plugin": "3.0.0-next.55",
		"@solidjs/web": "2.0.0-rc.20",
		"@types/node": "^24.19.2",
		"better-result": "3.0.1",
		"happy-dom": "21.0.4",
		"peculiar-sheets": "workspace:*",
		"sheet-scenarios": "workspace:*",
		"solid-js": "2.0.0-rc.20",
		"tslib": "^2.9.1",
		"tsx": "4.21.0",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	}
}
