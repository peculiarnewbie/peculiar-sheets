{
  "private": true,
	"scripts": {
		"build": "pnpm -r build",
		"dev": "pnpm -r --parallel dev",
		"build:lib": "pnpm --filter peculiar-sheets build",
		"pretypecheck": "pnpm --filter peculiar-sheets build",
		"typecheck": "pnpm -r typecheck",
		"typecheck:lib": "pnpm --filter peculiar-sheets typecheck",
		"build:www": "pnpm --filter solid-sheet-www build",
		"pack:check": "pnpm --filter peculiar-sheets pack:check && pnpm --filter peculiar-sheets-ironcalc pack:check",
		"publish": "pnpm run publish:core && pnpm run publish:ironcalc",
		"publish:core": "pnpm --filter peculiar-sheets run publish:npm",
		"publish:ironcalc": "pnpm --filter peculiar-sheets-ironcalc run publish:npm",
		"e2e": "bun run tests/e2e/run.ts",
		"e2e:dev": "pnpm --filter @peculiarnewbie/e2e dev",
		"benchmark": "bun run benchmarks/run.ts"
	},
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "devDependencies": {
    "@browserbasehq/stagehand": "^3.2.0",
    "peculiar-sheets": "workspace:*",
    "sheet-scenarios": "workspace:*",
    "tslib": "^2.8.1"
  }
}
